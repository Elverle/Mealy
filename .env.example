DATABASE_URL=postgresql://mealy:mealy@localhost:5432/mealy_dev

# Provider LLM: google | openrouter | anthropic | openai-compatible
LLM_PROVIDER=google
# Verificare che il modello sia disponibile nel proprio piano Gemini (https://ai.google.dev/gemini-api/docs/models); si cambia solo qui.
# gemini-2.5-flash non è più disponibile per i nuovi account. Sul piano gratuito Google può rispondere 503 "high demand" anche per ore.
LLM_MODEL=gemini-3.1-flash-lite
# Timeout di una singola chiamata LLM, in millisecondi. Deve restare sotto il limite di 120 s della route di generazione:
# i modelli gratuiti di OpenRouter possono superare i 50 s (circa 90 s per 3 ricette), in quel caso alzarlo fino a 110000.
LLM_TIMEOUT_MS=50000

# Serve solo la chiave del provider attivo (mai esposta al client)
GOOGLE_GENERATIVE_AI_API_KEY=

# Alternativa consigliata: OpenRouter con z-ai/glm-5.3-flash (a pagamento, circa 38 s per 3 ricette, costo trascurabile).
# Serve una chiave di inferenza, non una management key. Con altri modelli scegliere un id che supporti "structured_outputs".
# LLM_PROVIDER=openrouter
# LLM_MODEL=z-ai/glm-5.3-flash
OPENROUTER_API_KEY=

ANTHROPIC_API_KEY=

# Solo per LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
